# AquaGuard Server Configuration
PORT=4000
NODE_ENV=development

# Database Configuration
DB_PATH=./server/data/aquaguard.sqlite

# Demo & Simulation Engine Configuration
DEMO_MODE=true
SIMULATION_ENABLED=true
SIMULATION_INTERVAL_MS=5000
SIMULATION_SEED=42069
SIMULATION_ANOMALY_PROBABILITY=0.14
RETENTION_MAX_ROWS_PER_STATION=2500

# Authentication & IoT Ingestion Security
# Change these secrets before any production deployment!
JWT_SECRET=aquaguard-local-dev-jwt-secret-change-in-production-2026
IOT_INGEST_API_KEY=ag-iot-device-ingest-key-demo-2026

# Frontend API Configuration (used by Vite client)
VITE_API_BASE_URL=/api
